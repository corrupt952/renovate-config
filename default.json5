{
  assignees: ["corrupt952"],
  reviewers: ["corrupt952"],

  extends: [
    "config:best-practices",

    ":prHourlyLimitNone",
    ":prConcurrentLimitNone",

    // Keep biome.json $schema version in sync with @biomejs/biome package
    "customManagers:biomeVersions",
  ],

  timezone: "Asia/Tokyo",

  // config:best-practices only sets this for npm (security:minimumReleaseAgeNpm,
  // 3 days), so this fallback covers version updates in other ecosystems
  // (docker, actions, gomod, etc.) that would otherwise have no cooldown at all.
  minimumReleaseAge: "7 days",

  // Full-day Monday window. The built-in `schedule:weekly` / `schedule:earlyMondays`
  // only allows PRs in a narrow early-morning window, which the Mend-hosted
  // scheduler routinely misses and silently skips for a week
  // (renovatebot/renovate#35532).
  schedule: ["on monday"],

  // automergeStrategy is intentionally omitted: it is silently ignored when
  // platformAutomerge=true (renovatebot/renovate#41177). GitHub repo merge
  // settings control the actual strategy instead.
  platformAutomerge: true,

  packageRules: [
    {
      matchUpdateTypes: ["minor", "patch", "pin", "digest"],
      automerge: true,
    },

    // Action digests are left for review because minimumReleaseAge cannot hold a
    // retargeted tag: github-tags ages the update against the matched version's
    // original release timestamp, and that does not move when an existing tag is
    // force-pushed to new commits. A retargeted tag, the tj-actions/changed-files
    // pattern, would otherwise reach the default branch unreviewed.
    //
    // matchDepTypes is required: the github-actions manager also owns
    // jobs.<id>.container.image, whose depType is `container`, not `action`.
    {
      matchManagers: ["github-actions"],
      matchDepTypes: ["action"],
      matchUpdateTypes: ["digest"],
      automerge: false,
    },
  ],
}
