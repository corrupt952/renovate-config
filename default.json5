{
  assignees: ["corrupt952"],
  reviewers: ["corrupt952"],

  extends: [
    "config:best-practices",
    ":prHourlyLimitNone",
    ":prConcurrentLimitNone",
    "customManagers:biomeVersions",
  ],

  timezone: "Asia/Tokyo",

  // config:best-practices sets this for npm only, leaving docker/actions/gomod
  // with no cooldown.
  minimumReleaseAge: "7 days",

  // schedule:weekly and schedule:earlyMondays only allow a narrow early-morning
  // window, which the Mend-hosted scheduler routinely misses and then silently
  // skips for a week (renovatebot/renovate#35532).
  schedule: ["on monday"],

  // automergeStrategy is omitted deliberately: platformAutomerge=true silently
  // ignores it (renovatebot/renovate#41177).
  platformAutomerge: true,

  packageRules: [
    {
      matchUpdateTypes: ["minor", "patch", "pin", "digest"],
      automerge: true,
    },

    // github-tags ages a digest update against the matched version's original
    // release timestamp, which does not move when a tag is force-pushed to new
    // commits - so minimumReleaseAge cannot hold a retargeted tag.
    //
    // matchDepTypes is required: the github-actions manager also owns
    // jobs.<id>.container.image, whose depType is `container`, not `action`.
    {
      matchManagers: ["github-actions"],
      matchDepTypes: ["action"],
      matchUpdateTypes: ["digest"],
      automerge: false,
    },
  ],
}
